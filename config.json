          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "bypass",
        "outbound": "🌐 Direct"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-ir",
          "geoip-ir"
        ],
        "action": "bypass",
        "outbound": "🌐 Direct"
