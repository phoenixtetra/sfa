{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "Remote",
        "type": "udp",
        "server": "1.0.0.1",
        "detour": "Proxy"
      },
      {
        "tag": "Local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-ir",
        "server": "Local"
      }
    ],
    "strategy": "ipv4_only",
    "optimistic": true
  },
  "http_clients": [
    {
      "tag": "Proxy",
      "detour": "Proxy"
    }
  ],
  "inbounds": [
