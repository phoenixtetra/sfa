          "1xbet.com",
          "oq0lmo5kvlkxj.pro"
        ],
        "action": "route",
        "outbound": "🇨🇦 CA [1]"
      },
      {
        "domain_suffix": [
          "betexplorer.com",
          "oddsportal.com",
          "soccerstats.com"
        ],
        "action": "route",
        "outbound": "🇧🇬 BG [1]"
