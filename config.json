{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "type": "udp",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-ir",
        "server": "local"
      }
    ],
    "optimistic": {
      "enabled": true
    },
    "strategy": "ipv4_only"
  },
  "http_clients": [
    {
      "tag": "proxy",
      "detour": "proxy"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "address": "172.19.0.1/30",
      "auto_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "type": "selector",
      "outbounds": [
        "auto",
        "[1] 🇳🇱",
        "[2] 🇮🇹",
        "[3] 🇫🇷",
        "[4] 🇩🇪",
        "[5] 🇩🇪"
      ]
    },
    {
      "tag": "auto",
      "type": "urltest",
      "outbounds": [
        "[1] 🇳🇱",
        "[2] 🇮🇹",
        "[3] 🇫🇷",
        "[4] 🇩🇪",
        "[5] 🇩🇪"
      ],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "1h",
      "idle_timeout": "1h"
    },
    {
      "tag": "[1] 🇳🇱",
      "type": "vless",
      "server": "165.231.99.52",
      "server_port": 8443,
      "uuid": "6b03ffdd-6646-410b-b575-6c05eafdaf60",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "vusr-6aa2cf2b.adhil.uk",
        "utls": {
          "enabled": true,
          "fingerprint": "firefox"
        }
      }
    },
    {
      "tag": "[2] 🇮🇹",
      "type": "shadowsocks",
      "server": "91.201.65.122",
      "server_port": 9074,
      "method": "aes-256-cfb",
      "password": "p5wSkb2uM3pKSS3j"
    },
    {
      "tag": "[3] 🇫🇷",
      "type": "vless",
      "server": "13.39.117.250",
      "server_port": 22224,
      "uuid": "e4514801-0d5a-42ba-869f-39bd605aef9e"
    },
    {
      "tag": "[4] 🇩🇪",
      "type": "vless",
      "server": "91.107.179.8",
      "server_port": 15003,
      "uuid": "69d8dc73-20ff-4241-bdd8-a9d6d07553b6"
    },
    {
      "tag": "[5] 🇩🇪",
      "type": "hysteria2",
      "server": "31.76.27.23",
      "server_port": 37009,
      "obfs": {
        "type": "salamander",
        "password": "Telegram@vpnjey"
      },
      "password": "Telegram:vpnjey",
      "tls": {
        "enabled": true,
        "server_name": "de.vpnjey.store",
        "insecure": true
      }
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "bypass",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-ir",
          "geoip-ir"
        ],
        "action": "bypass",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "geosite-ir",
          "geoip-ir",
          "geosite-category-ads-all"
        ],
        "url": "https://cdn.jsdelivr.net/gh/chocolate4u/Iran-sing-box-rules@rule-set/{tag}.srs"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "remote",
    "default_http_client": "proxy"
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 8888,
      "dashboard": true
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "path": "cache.db"
    }
  }
}
