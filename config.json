        "🇬🇧 UK [1]",
        "🇮🇹 IT [1]",
        "🇹🇷 TR [1]",
        "🇺🇸 US [1]",
        "💻️ Proxy",
        "🌐 Direct"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "🧠 Smart",
      "type": "urltest",
      "outbounds": [
        "🇩🇪 DE [1]",
        "🇩🇪 DE [2]",
        "🇳🇱 NL [1]",
        "🇫🇷 FR [1]",
        "🇬🇧 UK [1]",
        "🇮🇹 IT [1]",
        "🇹🇷 TR [1]",
        "🇺🇸 US [1]"
      ],
