  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "bypass",
        "outbound": "Direct"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-ir",
          "geoip-ir"
        ],
        "action": "bypass",
        "outbound": "Direct"
      }
    ],
    "rule_set": [
      {
        "tag": [
          "geosite-ir",
          "geoip-ir",
          "geosite-category-ads-all"
        ],
        "type": "remote",
        "url": "https://github.com/Chocolate4U/Iran-sing-box-rules/raw/rule-set/{tag}.srs"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "Remote",
    "default_http_client": "Proxy"
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 8888,
      "dashboard": true
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "path": "cache.db"
    }
  }
}
