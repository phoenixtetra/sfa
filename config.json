{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "Quad9",
        "type": "udp",
        "server": "9.9.9.10",
        "detour": "Proxy"
      },
      {
        "tag": "Local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-ir",
        "server": "Local"
      }
    ],
    "optimistic": {
      "enabled": true
    },
    "strategy": "ipv4_only"
  },
  "http_clients": [
    {
      "tag": "Proxy",
      "detour": "Proxy"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "address": "172.19.0.1/30",
      "auto_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [
        "Auto",
        "[1] 🇫🇷",
        "[2] 🇬🇧",
        "[3] 🇬🇧",
        "[4] 🇫🇮",
        "[5] 🇵🇱",
        "[6] 🇮🇹",
        "[7] 🇨🇦",
        "📱",
        "Direct"
      ]
    },
    {
      "tag": "Auto",
      "type": "urltest",
      "outbounds": [
        "[1] 🇫🇷",
        "[2] 🇬🇧",
        "[3] 🇬🇧",
        "[4] 🇫🇮",
        "[5] 🇵🇱",
        "[6] 🇮🇹",
        "[7] 🇨🇦",
        "📱"
      ],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "1h",
      "idle_timeout": "1h"
    },
    {
      "tag": "[1] 🇫🇷",
      "type": "vless",
      "server": "35.181.77.1",
      "server_port": 22224,
      "uuid": "e4514801-0d5a-42ba-869f-39bd605aef9e"
    },
    {
      "tag": "[2] 🇬🇧",
      "type": "shadowsocks",
      "server": "146.70.23.32",
      "server_port": 8080,
      "method": "rc4-md5",
      "password": "14fFPrbezE3HDZzsMOr6"
    },
    {
      "tag": "[3] 🇬🇧",
      "type": "vmess",
      "server": "66.163.117.58",
      "server_port": 22324,
      "uuid": "04621bae-ab36-11ec-b909-0242ac120002",
      "security": "auto",
      "authenticated_length": true
    },
    {
      "tag": "[4] 🇫🇮",
      "type": "shadowsocks",
      "server": "37.202.246.212",
      "server_port": 2070,
      "method": "chacha20-ietf-poly1305",
      "password": "LMnotcv4RdaEOBXT-LdtfA"
    },
    {
      "tag": "[5] 🇵🇱",
      "type": "vless",
      "server": "144.31.5.64",
      "server_port": 443,
      "uuid": "cd3bb7d9-7df3-4644-ac05-c260990ac277",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "pl6.moritech.net",
        "alpn": "h2"
      }
    },
    {
      "tag": "[6] 🇮🇹",
      "type": "shadowsocks",
      "server": "91.201.65.122",
      "server_port": 9059,
      "method": "aes-256-cfb",
      "password": "9XwYyZsK8SNzQDtY"
    },
    {
      "tag": "[7] 🇨🇦",
      "type": "shadowsocks",
      "server": "51.222.155.113",
      "server_port": 5601,
