{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "type": "udp",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-ir",
        "server": "local"
      }
    ],
    "optimistic": {
      "enabled": true
    },
    "strategy": "ipv4_only"
  },
  "http_clients": [
    {
      "tag": "proxy",
      "detour": "proxy"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "address": "172.19.0.1/30",
      "auto_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "type": "selector",
      "outbounds": [
        "auto",
        "🇩🇪 [01]",
        "🇺🇸 [02]",
        "🇮🇹 [03]"
      ]
    },
    {
      "tag": "auto",
      "type": "urltest",
      "outbounds": [
        "🇩🇪 [01]",
        "🇺🇸 [02]",
        "🇮🇹 [03]"
      ],
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "1h",
      "idle_timeout": "1h"
    },
    {
      "tag": "🇩🇪 [01]",
      "type": "hysteria2",
      "server": "31.76.27.23",
      "server_port": 37009,
      "obfs": {
        "type": "salamander",
        "password": "Telegram@vpnjey"
      },
      "password": "Telegram:vpnjey",
      "tls": {
        "enabled": true,
        "server_name": "de.vpnjey.store",
        "insecure": true
      }
    },
    {
      "tag": "🇺🇸 [02]",
      "type": "vless",
      "server": "194.55.189.249",
      "server_port": 40443,
      "uuid": "8212a50b-25bf-4739-bba1-aaffb5ffc84c",
      "tls": {
        "enabled": true,
        "server_name": "deepl.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "KCbW84C8h2Ja01LS0Ro8EpLLfzMTjs11t1ldDWLd5zo",
          "short_id": "aae8"
        }
      }
    },
    {
      "tag": "🇮🇹 [03]",
      "type": "shadowsocks",
      "server": "91.201.65.122",
      "server_port": 9074,
      "method": "aes-256-cfb",
      "password": "p5wSkb2uM3pKSS3j"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "action": "bypass",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-ir",
          "geoip-ir"
        ],
        "action": "bypass",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "geosite-ir",
          "geoip-ir",
          "geosite-category-ads-all"
        ],
        "url": "https://cdn.jsdelivr.net/gh/chocolate4u/Iran-sing-box-rules@rule-set/{tag}.srs"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": "remote",
    "default_http_client": "proxy"
  },
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 8888,
      "dashboard": true
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "path": "cache.db"
    }
  }
}
