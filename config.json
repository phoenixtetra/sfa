{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn"
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "type": "udp",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-ir",
        "server": "local"
      }
    ],
    "optimistic": {
      "enabled": true
    },
    "strategy": "ipv4_only"
  },
  "http_clients": [
    {
      "tag": "proxy",
      "detour": "proxy"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "address": "172.19.0.1/30",
      "auto_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "type": "selector",
      "outbounds": [
        "auto",
        "[01] 🇹🇷",
        "[02] 🇩🇪",
        "[03] 🇫🇷",
        "[04] 🇩🇪",
        "[05] 🇩🇪",
        "[06] 🇮🇹"
      ]
    },
    {
      "tag": "auto",
      "type": "urltest",
      "outbounds": [
        "[01] 🇹🇷",
        "[02] 🇩🇪",
        "[03] 🇫🇷",
        "[04] 🇩🇪",
        "[05] 🇩🇪",
        "[06] 🇮🇹"
      ],
